# ADT code repo (kt1) — track SOURCE only. Exclude ckpt actuals, frame caches, data, outputs.
# --- large binaries: ckpts + frame caches + arrays ---
*.pt
*.pth
*.ckpt
*.bin
*.npy
*.npz
*.pkl
# --- generated molecules / structures / outputs ---
*.sdf
*.xyz
*.mol
*.smi
# --- old manual backups (moved to .trash; never track) ---
*.bak*
# --- big result dumps under paper_release (keep code/ + *.md only) ---
paper_release/funnel_pretrained/
paper_release/funnel_rlvr/
paper_release/**/xtb_results.json
# --- dirs ---
data/
logs/
__pycache__/
.trash/
# --- latex build artifacts (keep .tex/.md source) ---
*.pdf
*.aux
*.bbl
*.blg
*.synctex.gz
*.fdb_latexmk
*.fls
*.toc
# --- misc ---
*.pyc
*.pyo
*.log
*.out

# --- GitHub Pages payload (served from main/docs): must stay tracked ---
!docs/
!docs/data/
!docs/data/*.sdf

# --- dataset loader lives with the data dir but IS source: keep it tracked ---
!Drugs/data/
!Drugs/data/geom/
!Drugs/data/geom/load_drugs.py
